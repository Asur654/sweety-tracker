PORT=5000
NODE_ENV=development

# Database configuration
# Set USE_SQLITE=true to run without Docker or PostgreSQL installed
USE_SQLITE=false

# PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Or direct connection string
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sweety_db

# Authentication
JWT_SECRET=super_secret_jwt_key_sweety_app_replace_in_production
JWT_EXPIRES_IN=7d
